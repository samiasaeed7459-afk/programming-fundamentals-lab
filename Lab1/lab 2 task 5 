#include<iostream>
using namespace std;
int main( )
{
	//1. Area of circle
	double r, areaCircle;
	const double Pi = 3.14159;
	cout<<"Enter radius of Circle:";
	cin>>r;
	areaCircle =Pi*r*r;
	cout<<"Area of circle =" <<areaCircle<<"\n\n";
	
	//2. Area of Rectangle
	double length, width, areaReact;
	cout<<"Enter length and width of rectangle:";
	cin>>length>>width;
	areaReact = length * width;
	cout<<"Area of Rectangle =" << areaReact<<"\n\n";
	
	//3. Area of Triangle 
	double base, height , areaTri;
	cout<<" Enter base and height of triangle:";
	cin>> base >> height;
	areaTri = base * height * 0.5;
	cout<< " Area of triangle =" << areaTri<< "\n";
	return 0;
}